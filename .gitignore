# Dependencies
**/node_modules/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example

# Build output
**/dist/
**/build/
**/coverage/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*

# Runtime files
**/*.pid
**/*.seed
**/*.pid.lock

# Temporary files
**/tmp/
**/temp/

# Testing
**/coverage/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.vscode/
.idea/

# Optional local files
*.swp
*.swo